{
    "name": "MangaPark Image Fix",
    "description": "Simple extension to fix MangaPark's temporary issue with image loading",
    "version": "1.2.0",
    "manifest_version": 3,
    "permissions": [
        "scripting",
        "activeTab"
    ],
    "host_permissions": [
        "*://*.mangapark.org/*",
        "*://*.mangapark.net/*",
        "*://*.mangapark.to/*",
        "*://*.mangapark.io/*",
        "*://*.comicpark.org/*",
        "*://*.comicpark.to/*",
        "*://*.readpark.org/*",
        "*://*.readpark.net/*",
        "*://*.mpark.to/*",
        "*://*.fto.to/*",
        "*://*.jto.to/*"
    ],
    "action": {
        "default_popup": "mangapark.html",
        "default_icon": "mangapark.png"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.mangapark.org/*",
                "*://*.mangapark.net/*",
                "*://*.mangapark.to/*",
                "*://*.mangapark.io/*",
                "*://*.comicpark.org/*",
                "*://*.comicpark.to/*",
                "*://*.readpark.org/*",
                "*://*.readpark.net/*",
                "*://*.mpark.to/*",
                "*://*.fto.to/*",
                "*://*.jto.to/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}